# ---------------------------------------------------------------------------
# RepoLens environment configuration
# Copy to `.env` (or set these in your Vercel project settings).
# Every variable below is OPTIONAL — RepoLens runs unauthenticated out of the box.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Optional: GitHub API authentication ------------------------------------
# A classic PAT (no scopes) or a fine-grained token with *no* repository
# permissions is enough. Public repository search never needs private access.
# Benefits when set: 5,000 core + 30 search requests/min (vs 60 + 10),
# and GitHub *code search* becomes available (it requires authentication).
# Never prefix this with NEXT_PUBLIC_ — it must stay on the server.
GITHUB_TOKEN=

# --- Optional: PostgreSQL (saved repositories, collections, history) --------
# Without DATABASE_URL, saves/history fall back to the visitor's browser
# localStorage (not synced across devices) and the app still works fully.
# Example: postgresql://user:password@localhost:5432/repolens
DATABASE_URL=

# --- Optional: AI assistance for the "Project Idea" mode --------------------
# RepoLens' discovery modes use a deterministic, local keyword/technology
# extractor by default. AI is never required for search to work.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
