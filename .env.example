# Copy to .env.local. All values are placeholders. Never commit real credentials.
# Public read-only access; the legacy alias is used only if GITHUB_TOKEN is blank.
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=

# PostgreSQL. Run `npm run db:migrate` with a direct/session-mode URL before deploy.
DATABASE_URL=
PG_POOL_MAX=                  # 4 connections per process by default

# Optional managed Upstash REST (HTTPS URL + REST token, not a redis:// URL).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Independent random secrets, recommended >=32 characters, minimum 16.
CRON_SECRET=
DIAGNOSTICS_SECRET=

# Historical collector defaults. Eligibility and scheduler frequency are separate.
TRACKED_POOL_LIMIT=           # 40 (5–250)
SNAPSHOT_BATCH_SIZE=           # 40 (1–60)
SNAPSHOT_CONCURRENCY=          # 3 (1–3)
SNAPSHOT_INTERVAL_HOURS=       # 20 (1–48)
SNAPSHOT_TOLERANCE_HOURS=      # 36 (1–96)
REPOLENS_OVERVIEW_PROJECTS=    # off disables overview's optional recommendations

# Cache TTLs are seconds. Zero disables the corresponding GitHub cache.
GITHUB_RATE_LIMIT_TTL=        # 30
GITHUB_SEARCH_TTL=            # 300
GITHUB_DEVELOPERS_TTL=        # 900
GITHUB_REPOSITORY_TTL=        # 900
GITHUB_README_TTL=            # 3600
GITHUB_LANGUAGES_TTL=         # 3600
GITHUB_CONTRIBUTORS_TTL=      # 1800
GITHUB_COMMITS_TTL=           # 600
GITHUB_FILES_TTL=             # 3600
GITHUB_TRENDING_TTL=          # 900 (collector discovery query)
GITHUB_STALE_TTL=             # 86400 (extra last-known-good retention)

# Workflow admission limits (defaults per listed fixed window).
REPOLENS_TRENDING_LIMIT=      # 2 collector discovery searches/hour
REPOLENS_SNAPSHOT_LIMIT=      # 240 observations/hour
REPOLENS_ANALYSIS_LIMIT=      # 18 workflows/minute
REPOLENS_DISCOVERY_LIMIT=     # 24 workflows/minute
REPOLENS_REFRESH_LIMIT=       # 10 explicit tracking/admission requests/workspace/hour
REPOLENS_AI_LIMIT=            # 12 chat submissions/workspace/hour
REPOLENS_AI_GLOBAL_LIMIT=     # 160 chat submissions/day, lower per-process fallback

# Public repository intelligence (weights are normalized over measured categories).
REPOLENS_HEALTH_MAINTENANCE_WEIGHT=    # 20
REPOLENS_HEALTH_DOCUMENTATION_WEIGHT=  # 15
REPOLENS_HEALTH_TESTING_WEIGHT=        # 15
REPOLENS_HEALTH_ORGANIZATION_WEIGHT=   # 15
REPOLENS_HEALTH_DEPENDENCIES_WEIGHT=   # 15
REPOLENS_HEALTH_COMMUNITY_WEIGHT=      # 10
REPOLENS_HEALTH_RELEASES_WEIGHT=       # 10
REPOLENS_HEALTH_TTL=                   # 3600 seconds
REPOLENS_ARCHITECTURE_TTL=             # 86400 seconds
REPOLENS_DEPENDENCY_TTL=               # 21600 seconds
REPOLENS_ADVISORY_TTL=                 # 3600 seconds
REPOLENS_ADVISORY_BATCH_LIMIT=         # 80 exact version checks (1–150)

# Optional AI repository chat. Search and static reports do not use these keys.
AI_PROVIDER=                  # openai or anthropic
AI_MODEL=                     # gpt-4.1-mini or claude-haiku-4-5 by provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_API_KEY=                   # optional alias for primary provider only
AI_FALLBACK_PROVIDER=         # different provider; needs its own key
AI_FALLBACK_MODEL=
AI_TIMEOUT_MS=                # 12000 (1000–16000) per attempt
AI_MAX_OUTPUT_TOKENS=         # 950 (128–2000)
AI_DAILY_GLOBAL_ATTEMPTS=     # 160 provider attempts per UTC day globally
AI_DAILY_SESSION_ATTEMPTS=    # 24 provider attempts per UTC day per workspace
AI_STREAM_UPSTREAM=           # defaults on; off uses nonstreaming provider responses
AI_ANSWER_CACHE_TTL=          # 900 seconds (0–3600); 0 disables reuse
OPENAI_INPUT_USD_PER_MTOK=
OPENAI_OUTPUT_USD_PER_MTOK=
ANTHROPIC_INPUT_USD_PER_MTOK=
ANTHROPIC_OUTPUT_USD_PER_MTOK=
